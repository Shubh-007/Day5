{
  "title": "k6 Load Testing Results",
  "uid": "k6-load-test-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Virtual Users (VUs)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT last(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (%)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT mean(\"value\") * 100 FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP request duration (ms) - p95 / p50 / avg",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT percentile(\"value\", 95) AS \"p95\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT percentile(\"value\", 50) AS \"p50\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT mean(\"value\") AS \"avg\" FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total requests",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT count(\"value\") FROM \"http_reqs\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Checks pass rate (%)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
          "query": "SELECT mean(\"value\") * 100 FROM \"checks\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    }
  ]
}
