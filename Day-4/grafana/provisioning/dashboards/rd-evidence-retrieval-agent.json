{
  "title": "R&D Evidence Retrieval Agent - Overview",
  "uid": "rd-evidence-agent-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (http_target, http_method) (rate(http_server_requests_total[5m]))",
          "legendFormat": "{{http_method}} {{http_target}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request duration (p95, ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_target) (rate(http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "{{http_target}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total requests handled",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(http_server_requests_total)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by status code",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (http_status_code) (http_server_requests_total)",
          "legendFormat": "{{http_status_code}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Recent traces",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "Tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "Tempo" },
          "queryType": "search",
          "limit": 20
        }
      ]
    }
  ]
}
