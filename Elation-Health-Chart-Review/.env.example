# Elation Health Chart Review - Environment Configuration
# Copy this file to .env and fill in the values (never commit .env to git)

# ============================================================================
# AUTHENTICATION
# ============================================================================
# JWT secret key for signing access tokens
# Generate a strong key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# JWT expiry time in minutes
JWT_EXPIRY_MINUTES=60

# ============================================================================
# DATA ENCRYPTION AT REST
# ============================================================================
# Encryption key for patient data (Fernet)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or run: python backend/scripts/encrypt_patient_data.py
DATA_ENCRYPTION_KEY=your-fernet-encryption-key-here

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Frontend origin allowed to make API calls
# Dev: http://localhost:3000
# Prod: https://elation-health.example.com
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ============================================================================
# AUDIT LOGGING
# ============================================================================
# Path to audit log file for PHI access tracking
AUDIT_LOG_PATH=backend/logs/audit.log

# ============================================================================
# DEMO CREDENTIALS
# ============================================================================
# Demo user credentials are stored as PASSWORD HASHES in backend/data/users.json
# These are demo credentials only - NEVER use these patterns for production
#
# Available demo users:
#   Username: admin
#   Password: demo-admin-2026
#   Role: Admin (can see all patients)
#
#   Username: schen
#   Password: demo-schen-2026
#   Role: Clinician (can see Dr. Sarah Chen's patients: P001234)
#
#   Username: mpark
#   Password: demo-mpark-2026
#   Role: Clinician (can see Dr. Michael Park's patients: P005678)
#
# To add new users:
#   python backend/scripts/seed_users.py --add-user <username> <role> <display_name>
#
# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env file to git - it contains secrets
# 2. NEVER log or print JWT_SECRET_KEY or DATA_ENCRYPTION_KEY
# 3. Always use HTTPS in production (set CORS_ALLOWED_ORIGIN to https://...)
# 4. Rotate keys regularly (new JWT_SECRET_KEY invalidates all existing tokens)
# 5. For production: use AWS KMS, HashiCorp Vault, or similar for key management
# 6. Ensure backend/logs/ directory is readable/writable and not world-accessible
